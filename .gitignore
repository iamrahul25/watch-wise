# ---- Gradle / Android build output ----
.gradle/
build/
**/build/
captures/
.externalNativeBuild/
.cxx/
.kotlin/
!gradle/wrapper/gradle-wrapper.jar

# ---- Local machine config (never commit) ----
local.properties
.watch_address

# ---- Signing keys & secrets (never commit) ----
keystore.properties
signing.properties
*.jks
*.keystore

# ---- Packaged artifacts ----
*.apk
*.aab
*.ap_
*.dex
release/
# ...but not source sets named "release"
!**/src/release/

# ---- Android Studio / IntelliJ (keep shared settings, ignore personal state) ----
*.iml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropDown.xml
.idea/inspectionProfiles/Project_Default.xml

# ---- Personal editor / tool settings ----
.vscode/
.claude/settings.local.json

# ---- Logs & OS files ----
*.log
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---- Python (app.py) ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dev-only signing key for the pushed watch faces (needed to build them)
!watchfaces/watchface-signing.jks
