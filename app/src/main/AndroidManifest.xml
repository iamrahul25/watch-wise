<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Watch Face Push library declares minSdk 33; the app still runs on Wear OS 3+
         and only offers pushing when WatchFacePushManagerFactory.isSupported() (Wear OS 6+). -->
    <uses-sdk tools:overrideLibrary="androidx.wear.watchfacepush" />

    <!-- Marks this as a Wear OS (watch) app. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Watch Face Push: install our watch faces and make one active. -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />
    <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE" />

    <!-- Live steps / heart rate permissions are declared in debug builds only
         (src/debug/AndroidManifest.xml); release previews show sample values. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Works on its own; the phone companion (:mobile) is optional. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened from the phone companion (RemoteActivityHelper). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="face"
                    android:scheme="watchwise" />
            </intent-filter>
        </activity>

        <!-- Requests from the phone companion (same package and signing key only). -->
        <service
            android:name=".link.PhoneRequestService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/watchwise"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
